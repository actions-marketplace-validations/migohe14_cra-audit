{
  "name": "cra-audit",
  "version": "1.1.0",
  "description": "Audits npm, yarn, and pnpm projects for compliance with the European Cyber Resilience Act (CRA, EU Regulation 2024/2847) and BSI TR-03183: SBOM (CycloneDX/SPDX), known vulnerabilities, third-party components, and licenses.",
  "homepage": "https://github.com/migohe14/cra-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migohe14/cra-audit.git"
  },
  "bugs": {
    "url": "https://github.com/migohe14/cra-audit/issues"
  },
  "author": "Miguel Gonzalez (https://github.com/migohe14)",
  "keywords": [
    "cra",
    "cyber-resilience-act",
    "tr-03183",
    "bsi",
    "sbom",
    "cyclonedx",
    "spdx",
    "security",
    "audit",
    "compliance",
    "vulnerabilities",
    "licenses",
    "supply-chain",
    "yarn",
    "pnpm",
    "eu",
    "sbom-validation"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "cra-audit": "bin/cra-audit.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cra-audit.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "preferGlobal": true
}
