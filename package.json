    "audit",
    "compliance",
    "vulnerabilities",
    "licenses",
    "supply-chain"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "cra-audit": "bin/cra-audit.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cra-audit.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "preferGlobal": true
}
